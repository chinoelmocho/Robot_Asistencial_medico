        <child link="wheel_right_link" />
        <axis xyz="0.0 0.0 1.0" />
    </joint>
    <joint name="base_link_wheel_left_joint" type="continuous">
        <origin xyz="0.19999999 0.0 0.0" rpy="-3.141592653589793 -1.5707963267948966 0" />
        <parent link="base_link" />
        <child link="wheel_left_link" />
        <axis xyz="0.0 0.0 1.0" />
    </joint>
    <joint name="base_link_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.038" rpy="0 0 0"/>
    </joint>
    <joint name="base_link_imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.00" rpy="0 0 0"/>
    </joint>









    <ros2_control name="BobertGazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <!-- Ruedas de tracción — igual que antes -->
        <joint name="base_link_wheel_right_joint">
            <command_interface name="velocity">
            <param name="min">-10.0</param>
            <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_wheel_left_joint">
            <command_interface name="velocity">
            <param name="min">-10.0</param>
            <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Castors — solo state, sin command (ruedas libres) -->
        <joint name="base_link_front_caster_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_link_rear_caster_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="front_caster_link_front_road_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="rear_caster_link_rear_road_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>






</robot>
