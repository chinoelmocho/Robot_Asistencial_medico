        <parent link="base_link" />
        <child link="rear_caster_link" />
        <axis xyz="0.0 -4.179993756677534e-18 1.0" />
    </joint>
    <joint name="base_link_front_caster_joint" type="continuous">
        <origin xyz="0.0 -0.12202496 -0.03" rpy="3.141592653589793 -0.0 0.0" />
