    <joint name="base_link_camera_obstacle_joint" type="fixed">
        <origin xyz="0.0002 -0.19899999999999998 0.0895"
                rpy="0 0 -1.5707963267948966" />
        <parent link="base_link" />
        <child link="camera_obstacle_link" />
    </joint>
        
    <joint name="base_link_camera_interact_joint" type="fixed">
