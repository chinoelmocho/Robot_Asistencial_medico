        <child link="front_road_link" />
        <axis xyz="-1.0 0.0 0.0" />
    </joint>
    <joint name="base_link_wheel_right_joint" type="continuous">
        <origin xyz="-0.2 0.0 0.0" rpy="-3.141592653589793 -1.5707963267948966 0" />
