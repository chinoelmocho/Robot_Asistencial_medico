        <parent link="rear_caster_link" />
        <child link="rear_road_link" />
        <axis xyz="1.0 0.0 -3.3655926527265695e-36" />
    </joint>
    <joint name="front_caster_link_front_road_joint" type="continuous">
        <origin xyz="-0.014137249999999999 0.025 0.0455" rpy="-1.5707963267948966 -0.0 0.0" />
